# Kopieren nach .env und anpassen.
# Port, unter dem der Teddy Manager im Heimnetz erreichbar ist
PORT=8090
# Adresse, unter der das Handy den Manager erreicht (für die HTTP-Shortcuts-Konfiguration)
PUBLIC_URL=http://192.168.1.10:8090
# Ordner mit TeddyClouds Daten (darin library/, custom_img/, config/) – relativ zu diesem Ordner oder absolut
TEDDYCLOUD_DATA=../teddycloud/data
# Docker-Netz, in dem der TeddyCloud-Container hängt
TEDDYCLOUD_NETWORK=teddynet
# TeddyCloud-Web-API aus Sicht des Containers
TC_URL=http://teddycloud:80
TZ=Europe/Berlin
# Name des TeddyCloud-Containers (für „Zuletzt aufgelegt“ aus dem Log)
TEDDYCLOUD_CONTAINER=teddycloud
# „Zuletzt aufgelegt“ abschalten: TC_LOG_URL= (leer) setzen und den Dienst teddy-manager-logs entfernen
# GitHub-Repository für den Hinweis auf neue Versionen (leer = aus)
UPDATE_REPO=AnselmJo/teddy-manager
# Fertiges Image statt selbst bauen (z. B. ghcr.io/<user>/teddy-manager:latest) – leer = lokal bauen
IMAGE=
